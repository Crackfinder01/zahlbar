# Copy to .env and fill in. Never commit .env.
# Long random value, e.g. generated with: openssl rand -hex 32
ZAHLBAR_API_KEY=
# Default creditor (optional, can also be set with `zahlbar config set-creditor`)
ZAHLBAR_ACCOUNT=
ZAHLBAR_CREDITOR_NAME=
ZAHLBAR_CREDITOR_STREET=
ZAHLBAR_CREDITOR_HOUSE_NUM=
ZAHLBAR_CREDITOR_PCODE=
ZAHLBAR_CREDITOR_CITY=
ZAHLBAR_CREDITOR_COUNTRY=CH
