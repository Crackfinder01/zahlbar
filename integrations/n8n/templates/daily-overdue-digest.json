{
  "name": "Zahlbar - daily list of overdue QR invoices",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [ { "field": "cronExpression", "expression": "0 8 * * 1-5" } ] }
      },
      "name": "Every weekday 08:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.ZAHLBAR_URL }}/v1/invoices",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendQuery": true,
        "queryParameters": { "parameters": [ { "name": "status", "value": "overdue" } ] },
        "options": {}
      },
      "name": "Zahlbar: overdue invoices",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 0]
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json).flat();\nconst lines = rows.map(r => `${r.number}: ${r.open_amount} ${r.currency} (due ${r.due_date})`);\nreturn [{ json: { count: rows.length, text: rows.length ? `Overdue invoices:\\n${lines.join('\\n')}` : 'Nothing overdue today.' } }];"
      },
      "name": "Build summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 0]
    }
  ],
  "connections": {
    "Every weekday 08:00": { "main": [ [ { "node": "Zahlbar: overdue invoices", "type": "main", "index": 0 } ] ] },
    "Zahlbar: overdue invoices": { "main": [ [ { "node": "Build summary", "type": "main", "index": 0 } ] ] }
  },
  "settings": {},
  "meta": { "templateCredsSetupCompleted": false },
  "pinData": {}
}
